<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:local="clr-namespace:PCL;assembly=Plain Craft Launcher 2">
    <local:MyHint Margin="0,0,0,15" IsWarn="False"
                  Text="欢迎使用 PCL-梦港（PCL-DreamPort PoC 原型）。本主页由 PCL 原生 XAML 渲染器承载，Phase 2 起将由 DreamPort 后端动态推送更新。" />
    <local:MyCard Title="夏日小镇 · DreamPort" Margin="0,0,0,15">
        <StackPanel Margin="25,40,23,15">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="欢迎来到梦港！您可以在「工具 → 梦港账号」登录站点账号，在「启动 → 微软登录」绑定并选择正版账号，并在「设置 → 游戏管理」切换自建梦港镜像源（dl.xmcraft.cn）。" />
            <StackPanel Orientation="Horizontal">
                <local:MyButton Padding="13,6" Margin="0,0,10,0" ColorType="Highlight"
                                Text="打开梦港网页端" EventType="打开网页" EventData="https://xmcraft.cn" />
                <local:MyButton Padding="13,6" Margin="0,0,10,0"
                                Text="刷新主页" EventType="刷新主页" />
            </StackPanel>
        </StackPanel>
    </local:MyCard>
    <local:MyCard Title="合规与开源声明" Margin="0,0,0,15" CanSwap="True">
        <StackPanel Margin="25,40,23,15">
            <TextBlock TextWrapping="Wrap"
                       Text="PCL-梦港基于 Plain Craft Launcher (PCL) 与 PCL Community Edition (PCL CE) 独立二次开发，遵循原自定义分发指南与 Apache-2.0 许可公开源代码，与龙腾猫跃及 PCL 官方无关。" />
        </StackPanel>
    </local:MyCard>
</StackPanel>
