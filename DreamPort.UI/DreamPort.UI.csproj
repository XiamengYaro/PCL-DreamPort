<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyTitle>DreamPort.UI</AssemblyTitle>
        <AssemblyName>DreamPort.UI</AssemblyName>
        <Description>PCL-DreamPort 的 Avalonia 界面扩展层</Description>
        <Company>DreamPort</Company>
        <Product>PCL-DreamPort</Product>
        <Copyright>Copyright © DreamPort Contributors</Copyright>
        <RootNamespace>DreamPort.UI</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <LangVersion>15.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Configurations>Debug;CI;Release;Beta</Configurations>
        <Platforms>AnyCPU;x64;ARM64</Platforms>
        <PlatformTarget>$(Platform)</PlatformTarget>
        <NoWarn>$(NoWarn);CS9113</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.6" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="QRCoder" Version="1.9.0" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\DreamPort.Core\DreamPort.Core.csproj" />
        <ProjectReference Include="..\PCL.Core\PCL.Core.csproj" />
        <ProjectReference Include="..\PCL.Core.UI\PCL.Core.UI.csproj" />
    </ItemGroup>
</Project>
