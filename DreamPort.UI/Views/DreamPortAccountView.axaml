<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DreamPort.UI.ViewModels"
             x:Class="DreamPort.UI.Views.DreamPortAccountView"
             x:DataType="vm:DreamPortAccountViewModel"
             x:CompileBindings="True">
    <StackPanel Spacing="14">
        <Border Background="{DynamicResource ColorBrushBg0}"
                BorderBrush="{DynamicResource ColorBrush1}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10">
            <StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrush1}"
                           Text="状态提示（Phase 1 PoC 原型）" />
                <TextBlock TextWrapping="Wrap"
                           Text="{Binding StatusMessage}" />
                <ProgressBar Height="3"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}" />
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource ColorBrushWhite}"
                BorderBrush="{DynamicResource ColorBrushGray4}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="18,14">
            <StackPanel Spacing="10">
                <TextBlock FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrush1}"
                           Text="DreamPort 服务地址" />
                <TextBlock FontSize="12"
                           Opacity="0.8"
                           TextWrapping="Wrap"
                           Text="用于通过浏览器授权登录夏镇梦港站点账号及拉取服务端推送的 PCL 原生自定义主页（支持环境或本机自定义地址）。" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox Grid.Column="0"
                             IsEnabled="{Binding !IsBusy}"
                             Text="{Binding BaseUrl, Mode=TwoWay}" />
                    <Button Grid.Column="1"
                            Padding="14,6"
                            Command="{Binding CheckServerCommand}"
                            Content="检测连通性"
                            IsEnabled="{Binding !IsBusy}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource ColorBrushWhite}"
                BorderBrush="{DynamicResource ColorBrushGray4}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="18,14"
                IsVisible="{Binding IsNotLoggedIn}">
            <StackPanel Spacing="12">
                <TextBlock FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrush1}"
                           Text="通过浏览器登录 DreamPort" />
                <TextBlock FontSize="12"
                           Opacity="0.85"
                           TextWrapping="Wrap"
                           Text="点击下方按钮将打开 DreamPort 网页端进行安全授权确认（原生支持通行密钥、两步验证、图形验证码、账号注册与封禁说明；启动器不采集明文密码）。" />

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Padding="18,8"
                            Command="{Binding StartBrowserLoginCommand}"
                            Content="在浏览器中登录"
                            IsEnabled="{Binding !IsBusy}" />
                </StackPanel>

                <Border IsVisible="{Binding IsWaitingBrowserConfirm}"
                        Background="{DynamicResource ColorBrushBg0}"
                        BorderBrush="{DynamicResource ColorBrushGray4}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <StackPanel Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    Spacing="6">
                            <Border Background="White"
                                    CornerRadius="6"
                                    Padding="8">
                                <Image Width="160"
                                       Height="160"
                                       Source="{Binding QrCodeBitmap}"
                                       Stretch="Uniform" />
                            </Border>
                            <TextBlock FontSize="11"
                                       HorizontalAlignment="Center"
                                       Opacity="0.75"
                                       Text="也可用已登录的手机扫码确认" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           Text="正在等待确认授权" />
                                <TextBlock FontWeight="SemiBold"
                                           Opacity="0.85"
                                           Text="{Binding CountdownText}" />
                            </StackPanel>

                            <TextBlock FontSize="12"
                                       Opacity="0.82"
                                       TextWrapping="Wrap"
                                       Text="若浏览器未自动弹出或需要切换到其它浏览器，可复制下方授权链接打开：" />

                            <TextBox IsReadOnly="True"
                                     Text="{Binding ConfirmUrl}" />

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Padding="14,6"
                                        Command="{Binding ReopenBrowserCommand}"
                                        Content="重新打开浏览器" />
                                <Button Padding="14,6"
                                        Command="{Binding CancelBrowserLoginCommand}"
                                        Content="取消等待" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource ColorBrushWhite}"
                BorderBrush="{DynamicResource ColorBrushGray4}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="18,14"
                IsVisible="{Binding IsLoggedIn}">
            <StackPanel Spacing="10">
                <TextBlock FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrush1}"
                           Text="当前已登录账号" />
                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Text="{Binding LoggedInUsername}" />
                <TextBlock TextWrapping="Wrap"
                           Opacity="0.88"
                           Text="{Binding AccountMetaSummary}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Padding="14,6"
                            Command="{Binding ValidateAndRefreshProfileCommand}"
                            Content="校验并刷新资料"
                            IsEnabled="{Binding !IsBusy}" />
                    <Button Padding="14,6"
                            Command="{Binding LogoutCommand}"
                            Content="退出登录"
                            IsEnabled="{Binding !IsBusy}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource ColorBrushWhite}"
                BorderBrush="{DynamicResource ColorBrushGray4}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="18,14">
            <StackPanel Spacing="10">
                <TextBlock FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrush1}"
                           Text="PCL 原生自定义主页来源（PoC 联调开关）" />
                <TextBlock FontSize="12"
                           Opacity="0.8"
                           TextWrapping="Wrap"
                           Text="默认优先请求站点的 /api/client/pcl-homepage，若后端尚未部署或离线则静默回退到内置原型 XAML。" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <ComboBox Grid.Column="0"
                              SelectedIndex="{Binding HomepageModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="远端推送优先（不可用时回退内置原型）" />
                        <ComboBoxItem Content="仅使用内置 XAML 原型" />
                        <ComboBoxItem Content="空白主页（关闭自定义内容）" />
                    </ComboBox>
                    <Button Grid.Column="1"
                            Padding="14,6"
                            Command="{Binding ApplyHomepageModeCommand}"
                            Content="应用并刷新主页" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
