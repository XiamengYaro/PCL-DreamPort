<ui:MyPageRight xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:PCL"
                xmlns:dpvm="using:DreamPort.UI.ViewModels"
                xmlns:ui="using:PCL.UI.Controls"
                x:DataType="vm:PageToolsDreamPortSyncViewModel"
                x:CompileBindings="True"
                x:Class="PCL.Views.Pages.Tools.PageToolsDreamPortSync">
    <ui:MyScrollViewer x:Name="PanBack"
                       HorizontalScrollBarVisibility="Disabled"
                       VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25,10">
            <ui:MyHint x:Name="HintStatus"
                       Margin="0,15,0,0"
                       Theme="Blue"
                       Text="{Binding StatusHint}" />

            <!-- 1. 服务器配套模组同步 -->
            <ui:MyCard Margin="0,15"
                       Title="服务器配套模组同步（双源清单 + 兼容性硬拦截）">
                <StackPanel Margin="25,40,25,20"
                            Spacing="12">
                    <TextBlock TextWrapping="Wrap"
                               Text="{Binding SelectedInstanceSummary}" />
                    <TextBlock TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource ColorBrushGray4}"
                               Text="{Binding ServerPackSummary}" />

                    <ui:MyHint IsVisible="{Binding HasCompatibilityWarning}"
                               Theme="Red"
                               Text="{Binding CompatibilitySummary}" />

                    <TextBlock IsVisible="{Binding IsApplying}"
                               FontSize="12"
                               Foreground="{DynamicResource ColorBrush3}"
                               TextWrapping="Wrap"
                               Text="{Binding ProgressSummary}" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="10">
                        <ui:MyButton MinWidth="130"
                                     Height="34"
                                     ColorType="Highlight"
                                     Command="{Binding CheckServerPackCommand}"
                                     IsEnabled="{Binding CanCheck}"
                                     Text="检查配套模组" />
                        <ui:MyButton MinWidth="120"
                                     Height="34"
                                     ColorType="Highlight"
                                     Command="{Binding ApplyServerPackCommand}"
                                     IsEnabled="{Binding CanApply}"
                                     Text="开始同步" />
                        <ui:MyButton MinWidth="100"
                                     Height="34"
                                     ColorType="Red"
                                     IsVisible="{Binding IsApplying}"
                                     Command="{Binding CancelServerPackCommand}"
                                     Text="取消同步" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold"
                                   Text="服务端直传文件变更计划" />
                        <TextBlock IsVisible="{Binding HasNoPendingFileActions}"
                                   FontSize="12"
                                   Foreground="{DynamicResource ColorBrushGray4}"
                                   Text="暂无待下载、覆盖或清理的直传文件。" />
                        <ItemsControl IsVisible="{Binding HasPendingFileActions}"
                                      ItemsSource="{Binding PendingFileActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dpvm:DreamPortServerPackFileItemVm">
                                    <Border Margin="0,6,0,0"
                                            BorderBrush="{DynamicResource ColorBrushGray4}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="12">
                                            <TextBlock Grid.Column="0"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ColorBrush3}"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding ActionLabel}" />
                                            <StackPanel Grid.Column="1"
                                                        Spacing="2">
                                                <TextBlock FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding PathText}" />
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource ColorBrushGray4}"
                                                           Text="{Binding DetailText}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HasModrinthItems}"
                                Spacing="6">
                        <TextBlock FontWeight="SemiBold"
                                   Text="Modrinth 指定模组清单" />
                        <ItemsControl ItemsSource="{Binding ModrinthItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dpvm:DreamPortModrinthModItemVm">
                                    <Border Margin="0,6,0,0"
                                            BorderBrush="{DynamicResource ColorBrushGray4}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="10">
                                            <StackPanel Grid.Column="0"
                                                        Spacing="2">
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding Title}" />
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource ColorBrushGray4}"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding DetailText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding StatusLabel}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ui:MyCard>

            <!-- 2. 存档云备份 -->
            <ui:MyCard Margin="0,0,0,15"
                       CanSwap="True"
                       Title="存档云备份（分块断点续传 + SHA-256 校验）">
                <StackPanel Margin="25,40,25,20"
                            Spacing="12">
                    <TextBlock TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource ColorBrushGray4}"
                               Text="{Binding CloudQuotaSummary}" />
                    <TextBlock IsVisible="{Binding IsCloudSaveRunning}"
                               FontSize="12"
                               Foreground="{DynamicResource ColorBrush3}"
                               TextWrapping="Wrap"
                               Text="{Binding CloudSaveProgressText}" />

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10">
                        <ui:MyTextBox Grid.Column="0"
                                      IsEnabled="{Binding CanOperatePhase5}"
                                      HintText="可选：上传展示名称（留空用原存档名）"
                                      Text="{Binding CloudSaveDisplayName, Mode=TwoWay}" />
                        <ui:MyTextBox Grid.Column="1"
                                      IsEnabled="{Binding CanOperatePhase5}"
                                      HintText="可选：备份备注（如：下矿前存档）"
                                      Text="{Binding CloudSaveNote, Mode=TwoWay}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                Spacing="10">
                        <ui:MyButton MinWidth="130"
                                     Height="34"
                                     ColorType="Highlight"
                                     Command="{Binding RefreshCloudSavesCommand}"
                                     IsEnabled="{Binding CanOperatePhase5}"
                                     Text="刷新云存档与本地世界" />
                        <ui:MyButton MinWidth="100"
                                     Height="34"
                                     ColorType="Red"
                                     IsVisible="{Binding IsCloudSaveRunning}"
                                     Command="{Binding CancelCloudSaveCommand}"
                                     Text="取消任务" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold"
                                   Text="当前实例本地世界（上传时自动跳过 session.lock）" />
                        <TextBlock IsVisible="{Binding HasNoLocalWorlds}"
                                   FontSize="12"
                                   Foreground="{DynamicResource ColorBrushGray4}"
                                   Text="当前实例的 saves 目录为空或尚未选择有效实例。" />
                        <ItemsControl IsVisible="{Binding HasLocalWorlds}"
                                      ItemsSource="{Binding LocalWorlds}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dpvm:DreamPortLocalWorldItemVm">
                                    <Border Margin="0,6,0,0"
                                            BorderBrush="{DynamicResource ColorBrushGray4}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="10">
                                            <StackPanel Grid.Column="0"
                                                        Spacing="2">
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding HeaderText}" />
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource ColorBrushGray4}"
                                                           Text="{Binding MetaText}" />
                                            </StackPanel>
                                            <ui:MyButton Grid.Column="1"
                                                         MinWidth="105"
                                                         Height="32"
                                                         ColorType="Highlight"
                                                         Command="{Binding UploadCommand}"
                                                         Text="备份到云端" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold"
                                   Text="云端备份记录（恢复自动防覆盖 + Zip-Slip 拦截）" />
                        <TextBlock IsVisible="{Binding HasNoCloudBackups}"
                                   FontSize="12"
                                   Foreground="{DynamicResource ColorBrushGray4}"
                                   Text="云端暂无备份记录。" />
                        <ItemsControl IsVisible="{Binding HasCloudBackups}"
                                      ItemsSource="{Binding CloudBackups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dpvm:DreamPortCloudSaveItemVm">
                                    <Border Margin="0,6,0,0"
                                            BorderBrush="{DynamicResource ColorBrushGray4}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                                  ColumnSpacing="8">
                                                <ui:MyTextBox Grid.Column="0"
                                                              Text="{Binding EditableDisplayName, Mode=TwoWay}" />
                                                <ui:MyButton Grid.Column="1"
                                                             MinWidth="76"
                                                             Height="32"
                                                             Command="{Binding RenameCommand}"
                                                             Text="重命名" />
                                                <ui:MyButton Grid.Column="2"
                                                             MinWidth="112"
                                                             Height="32"
                                                             ColorType="Highlight"
                                                             IsEnabled="{Binding IsReady}"
                                                             Command="{Binding RestoreCommand}"
                                                             Text="恢复到实例" />
                                                <ui:MyButton Grid.Column="3"
                                                             MinWidth="68"
                                                             Height="32"
                                                             ColorType="Red"
                                                             Command="{Binding DeleteCommand}"
                                                             Text="删除" />
                                            </Grid>
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource ColorBrushGray4}"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding MetaText}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ui:MyCard>

            <!-- 3. 多设备白名单配置云同步 -->
            <ui:MyCard Margin="0,0,0,15"
                       CanSwap="True"
                       Title="多设备白名单配置云同步（乐观锁防静默覆盖）">
                <StackPanel Margin="25,40,25,20"
                            Spacing="12">
                    <TextBlock TextWrapping="Wrap"
                               Text="{Binding ProfileSyncSummary}" />
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource ColorBrushGray4}"
                               TextWrapping="Wrap"
                               Text="隐私约束：仅同步更新频道、下载并发、窗口大小、字体、语言与四款蓝色主题等可移植配置；账号凭据、MirrorChyan Key、代理帐密、Java 本机路径与自定义启动参数永不上传。" />

                    <ui:MyHint IsVisible="{Binding HasProfileConflict}"
                               Theme="Yellow"
                               Text="{Binding ProfileConflictSummary}" />

                    <WrapPanel Orientation="Horizontal">
                        <ui:MyButton Margin="0,0,10,8"
                                     MinWidth="116"
                                     Height="34"
                                     Command="{Binding RefreshProfileSyncCommand}"
                                     IsEnabled="{Binding CanOperatePhase5}"
                                     Text="检查云端状态" />
                        <ui:MyButton Margin="0,0,10,8"
                                     MinWidth="116"
                                     Height="34"
                                     ColorType="Highlight"
                                     Command="{Binding PushProfileSyncCommand}"
                                     IsEnabled="{Binding CanOperatePhase5}"
                                     Text="上传本机配置" />
                        <ui:MyButton Margin="0,0,10,8"
                                     MinWidth="116"
                                     Height="34"
                                     Command="{Binding PullProfileSyncCommand}"
                                     IsEnabled="{Binding CanOperatePhase5}"
                                     Text="拉取云端配置" />
                        <ui:MyButton Margin="0,0,10,8"
                                     MinWidth="138"
                                     Height="34"
                                     ColorType="Red"
                                     IsVisible="{Binding HasProfileConflict}"
                                     Command="{Binding ForcePushProfileSyncCommand}"
                                     IsEnabled="{Binding CanOperatePhase5}"
                                     Text="强制本机覆盖云端" />
                        <ui:MyButton Margin="0,0,10,8"
                                     MinWidth="116"
                                     Height="34"
                                     ColorType="Red"
                                     Command="{Binding ResetProfileSyncCommand}"
                                     IsEnabled="{Binding CanOperatePhase5}"
                                     Text="清空云端配置" />
                    </WrapPanel>
                </StackPanel>
            </ui:MyCard>

            <!-- 4. AI 启动日志排障 -->
            <ui:MyCard Margin="0,0,0,15"
                       CanSwap="True"
                       Title="AI 启动日志排障（自动脱敏 + 异步轮询）">
                <StackPanel Margin="25,40,25,20"
                            Spacing="12">
                    <TextBlock TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource ColorBrushGray4}"
                               Text="{Binding LogDiagnoseStatusSummary}" />
                    <TextBlock IsVisible="{Binding LogDiagnosePreviewSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="{Binding LogDiagnosePreviewSummary}" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="10">
                        <ui:MyButton MinWidth="126"
                                     Height="34"
                                     Command="{Binding PrepareLogDiagnoseCommand}"
                                     IsEnabled="{Binding CanOperatePhase5}"
                                     Text="准备脱敏日志" />
                        <ui:MyButton MinWidth="126"
                                     Height="34"
                                     ColorType="Highlight"
                                     Command="{Binding SubmitLogDiagnoseCommand}"
                                     IsEnabled="{Binding CanSubmitLogDiagnose}"
                                     Text="提交 AI 诊断" />
                        <ui:MyButton MinWidth="100"
                                     Height="34"
                                     ColorType="Red"
                                     IsVisible="{Binding IsLogDiagnoseRunning}"
                                     Command="{Binding CancelLogDiagnoseCommand}"
                                     Text="取消诊断" />
                    </StackPanel>

                    <Border IsVisible="{Binding HasLogDiagnoseResult}"
                            BorderBrush="{DynamicResource ColorBrushGray4}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Text="{Binding LogDiagnoseResultSummary}" />
                            <ItemsControl IsVisible="{Binding HasLogDiagnoseItems}"
                                          ItemsSource="{Binding LogDiagnoseItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="dpvm:DreamPortLogDiagnoseItemVm">
                                        <Border Margin="0,6,0,0"
                                                BorderBrush="{DynamicResource ColorBrushGray4}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="10">
                                            <StackPanel Spacing="4">
                                                <TextBlock FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding HeaderText}" />
                                                <TextBlock IsVisible="{Binding EvidenceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource ColorBrushGray4}"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding EvidenceText}" />
                                                <TextBlock FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding AdviceText}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock IsVisible="{Binding HasLogDiagnoseAskFor}"
                                       FontSize="12"
                                       Foreground="{DynamicResource ColorBrushGray4}"
                                       TextWrapping="Wrap"
                                       Text="{Binding LogDiagnoseAskForText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:MyCard>
        </StackPanel>
    </ui:MyScrollViewer>
</ui:MyPageRight>
