<ui:MyPageRight xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:dpvm="using:DreamPort.UI.ViewModels"
                xmlns:ui="using:PCL.UI.Controls"
                x:DataType="dpvm:DreamPortAccountViewModel"
                x:CompileBindings="True"
                x:Class="PCL.Views.Pages.Tools.PageToolsDreamPortAccount">
    <ui:MyScrollViewer x:Name="PanBack"
                       HorizontalScrollBarVisibility="Disabled"
                       VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25,10">
            <ui:MyHint x:Name="HintStatus"
                       Margin="0,15,0,0"
                       IsVisible="{Binding HasStatusMessage}"
                       Theme="Blue"
                       Text="{Binding StatusMessage}" />

            <ui:MyCard Margin="0,15,0,15"
                       IsVisible="{Binding IsNotLoggedIn}"
                       Title="通过浏览器登录 DreamPort">
                <StackPanel Margin="25,40,25,20"
                            Spacing="12">
                    <TextBlock TextWrapping="Wrap"
                               Text="使用浏览器完成 DreamPort 安全授权登录。启动器不会读取或保存你的密码。" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="12">
                        <ui:MyButton MinWidth="150"
                                     Height="35"
                                     ColorType="Highlight"
                                     Command="{Binding StartBrowserLoginCommand}"
                                     IsEnabled="{Binding IsNotBusy}"
                                     Text="在浏览器中登录" />
                    </StackPanel>

                    <Border IsVisible="{Binding IsWaitingBrowserConfirm}"
                            Margin="0,4,0,0"
                            BorderBrush="{DynamicResource ColorBrushGray4}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="16">
                            <StackPanel Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        Spacing="6">
                                <Border Background="White"
                                        CornerRadius="6"
                                        Padding="8">
                                    <Image Width="156"
                                           Height="156"
                                           Source="{Binding QrCodeBitmap}"
                                           Stretch="Uniform" />
                                </Border>
                                <TextBlock FontSize="12"
                                           HorizontalAlignment="Center"
                                           Text="也可用已登录的手机扫码确认" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="12">
                                    <TextBlock FontWeight="Bold"
                                               Text="正在等待确认授权" />
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding CountdownText}" />
                                </StackPanel>

                                <TextBlock TextWrapping="Wrap"
                                           Text="若浏览器未自动弹出或需要切换到其它浏览器，可复制下方授权链接打开：" />

                                <ui:MyTextBox IsReadOnly="True"
                                              Text="{Binding ConfirmUrl}" />

                                <StackPanel Orientation="Horizontal"
                                            Spacing="12">
                                    <ui:MyButton MinWidth="130"
                                                 Height="35"
                                                 ColorType="Highlight"
                                                 Command="{Binding ReopenBrowserCommand}"
                                                 Text="重新打开浏览器" />
                                    <ui:MyButton MinWidth="100"
                                                 Height="35"
                                                 Command="{Binding CancelBrowserLoginCommand}"
                                                 Text="取消等待" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ui:MyCard>

            <ui:MyCard Margin="0,15,0,15"
                       IsVisible="{Binding IsLoggedIn}"
                       Title="当前已登录账号">
                <StackPanel Margin="25,40,25,20"
                            Spacing="10">
                    <TextBlock FontSize="16"
                               FontWeight="Bold"
                               Text="{Binding LoggedInUsername}" />
                    <TextBlock LineHeight="20"
                               TextWrapping="Wrap"
                               Text="{Binding AccountMetaSummary}" />
                    <StackPanel Margin="0,4,0,0"
                                Orientation="Horizontal"
                                Spacing="12">
                        <ui:MyButton MinWidth="130"
                                     Height="35"
                                     ColorType="Highlight"
                                     Command="{Binding ValidateAndRefreshProfileCommand}"
                                     IsEnabled="{Binding IsNotBusy}"
                                     Text="校验并刷新资料" />
                        <ui:MyButton MinWidth="130"
                                     Height="35"
                                     Command="{Binding OpenSecuritySettingsInBrowserCommand}"
                                     Text="安全与通行密钥" />
                        <ui:MyButton MinWidth="100"
                                     Height="35"
                                     ColorType="Red"
                                     Command="{Binding LogoutCommand}"
                                     IsEnabled="{Binding IsNotBusy}"
                                     Text="退出登录" />
                    </StackPanel>
                </StackPanel>
            </ui:MyCard>

            <ui:MyCard Margin="0,0,0,15"
                       CanSwap="True"
                       IsVisible="{Binding ShowRewardsCard}"
                       Title="每日签到 · 积分与称号">
                <StackPanel Margin="25,40,25,20"
                            Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="14"
                          RowSpacing="8">
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Foreground="{DynamicResource ColorBrushGray4}"
                                   Text="站点积分" />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   FontWeight="SemiBold"
                                   Text="{Binding PointsBalanceText}" />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="2"
                                   Foreground="{DynamicResource ColorBrushGray4}"
                                   Text="今日签到" />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="3"
                                   FontWeight="SemiBold"
                                   Text="{Binding SigninStatusText}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Foreground="{DynamicResource ColorBrushGray4}"
                                   Text="签到统计" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding SigninStreakText}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   Foreground="{DynamicResource ColorBrushGray4}"
                                   Text="任务奖励" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="3"
                                   Text="{Binding PendingTasksText}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                Spacing="10">
                        <ui:MyButton MinWidth="110"
                                     Height="34"
                                     ColorType="Highlight"
                                     Command="{Binding ManualSigninCommand}"
                                     IsEnabled="{Binding CanManualSignin}"
                                     Text="立即签到" />
                        <ui:MyButton MinWidth="120"
                                     Height="34"
                                     Command="{Binding RefreshRewardsAndTitlesCommand}"
                                     IsEnabled="{Binding IsNotBusy}"
                                     Text="刷新积分与称号" />
                        <ui:MyButton MinWidth="120"
                                     Height="34"
                                     Command="{Binding OpenTasksCenterCommand}"
                                     Text="打开任务中心" />
                    </StackPanel>

                    <Border Margin="0,4,0,0"
                            BorderBrush="{DynamicResource ColorBrushGray4}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding EquippedTitleText, StringFormat='当前佩戴称号：{0}'}" />
                            <Grid IsVisible="{Binding HasOwnedTitles}"
                                  ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="10">
                                <ui:MyComboBox Grid.Column="0"
                                               HorizontalAlignment="Stretch"
                                               ItemsSource="{Binding OwnedTitles}"
                                               SelectedItem="{Binding SelectedTitleOption, Mode=TwoWay}">
                                    <ui:MyComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="dpvm:DreamPortTitleOption">
                                            <TextBlock Text="{Binding DisplayText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ui:MyComboBox.ItemTemplate>
                                </ui:MyComboBox>
                                <ui:MyButton Grid.Column="1"
                                             MinWidth="96"
                                             Height="34"
                                             ColorType="Highlight"
                                             Command="{Binding ApplySelectedTitleCommand}"
                                             IsEnabled="{Binding CanApplySelectedTitle}"
                                             Text="佩戴称号" />
                                <ui:MyButton Grid.Column="2"
                                             MinWidth="96"
                                             Height="34"
                                             Command="{Binding UnequipTitleCommand}"
                                             IsEnabled="{Binding CanUnequipTitle}"
                                             Text="卸下称号" />
                            </Grid>
                            <TextBlock IsVisible="{Binding !HasOwnedTitles}"
                                       FontSize="12"
                                       Foreground="{DynamicResource ColorBrushGray4}"
                                       TextWrapping="Wrap"
                                       Text="暂无已获得的称号，可通过完成每日签到、成就或前往任务兑换中心获取。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:MyCard>

            <ui:MyCard Margin="0,0,0,15"
                       IsVisible="{Binding ShowEntryFlowCard}"
                       Title="入服引导与账号验证">
                <StackPanel Margin="25,40,25,20"
                            Spacing="14">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="14">
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding ProgressSummaryText}" />
                            <TextBlock Text="{Binding QqBindModeText}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding StepItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dpvm:DreamPortProgressStepVm">
                                    <Border Margin="0,6,8,0"
                                            Padding="10,6"
                                            BorderBrush="{DynamicResource ColorBrushGray4}"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <TextBlock FontSize="12"
                                                   Text="{Binding DetailText}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border IsVisible="{Binding IsBanned}"
                            BorderBrush="{DynamicResource ColorBrushGray4}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="Bold"
                                       Text="账号当前处于封禁状态" />
                            <TextBlock TextWrapping="Wrap"
                                       Text="{Binding BanDetailText}" />
                            <StackPanel Orientation="Horizontal">
                                <ui:MyButton MinWidth="140"
                                             Height="34"
                                             ColorType="Red"
                                             Command="{Binding OpenBanAppealInBrowserCommand}"
                                             Text="前往网页封禁申诉" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsRejected}"
                            BorderBrush="{DynamicResource ColorBrushGray4}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock FontWeight="Bold"
                                       Text="入服审核未通过 / 问卷申诉" />
                            <TextBlock IsVisible="{Binding HasAppealStatus}"
                                       TextWrapping="Wrap"
                                       Text="{Binding AppealStatusText}" />
                            <ui:MyTextBox AcceptsReturn="True"
                                          MinHeight="66"
                                          TextWrapping="Wrap"
                                          HintText="请填写申诉理由，至少 10 个字"
                                          IsEnabled="{Binding CanSubmitAppeal}"
                                          Text="{Binding AppealReasonInput, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal">
                                <ui:MyButton MinWidth="130"
                                             Height="34"
                                             ColorType="Highlight"
                                             Command="{Binding SubmitAppealCommand}"
                                             IsEnabled="{Binding CanSubmitAppeal}"
                                             Text="提交人工复核申诉" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{DynamicResource ColorBrushGray4}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold"
                                       Text="步骤 2 · QQ 账号绑定" />
                            <TextBlock TextWrapping="Wrap"
                                       Text="{Binding QqStatusSummary}" />
                            <TextBlock IsVisible="{Binding HasQqUnavailableHint}"
                                       TextWrapping="Wrap"
                                       Text="{Binding QqUnavailableHint}" />
                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="10">
                                <ui:MyTextBox Grid.Column="0"
                                              HintText="输入从机器人私聊获得的 QQ 绑定验证码"
                                              IsEnabled="{Binding CanBindQq}"
                                              Text="{Binding QqBindCodeInput, Mode=TwoWay}" />
                                <ui:MyButton Grid.Column="1"
                                             MinWidth="100"
                                             Height="34"
                                             ColorType="Highlight"
                                             Command="{Binding BindQqCommand}"
                                             IsEnabled="{Binding CanBindQq}"
                                             Text="验证绑定" />
                                <ui:MyButton Grid.Column="2"
                                             MinWidth="90"
                                             Height="34"
                                             ColorType="Red"
                                             IsVisible="{Binding IsQqBound}"
                                             Command="{Binding UnbindQqCommand}"
                                             IsEnabled="{Binding CanUnbindQq}"
                                             Text="解绑 QQ" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel IsVisible="{Binding ShowVerificationSections}"
                                Spacing="14">
                        <Border BorderBrush="{DynamicResource ColorBrushGray4}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold"
                                           Text="步骤 3 · Minecraft 正版 ID 验证" />
                                <TextBlock TextWrapping="Wrap"
                                           Text="{Binding McStatusSummary}" />
                                <TextBlock FontSize="12"
                                           TextWrapping="Wrap"
                                           Text="{Binding ActiveMcProfileHint}" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="10">
                                    <ui:MyButton MinWidth="180"
                                                 Height="34"
                                                 ColorType="Highlight"
                                                 Command="{Binding VerifyMinecraftWithCurrentProfileCommand}"
                                                 IsEnabled="{Binding IsNotBusy}"
                                                 Text="使用当前正版档案一键验证" />
                                    <ui:MyButton MinWidth="140"
                                                 Height="34"
                                                 IsVisible="{Binding IsMsaFallbackEnabled}"
                                                 Command="{Binding StartMsaVerifyCommand}"
                                                 IsEnabled="{Binding IsNotBusy}"
                                                 Text="微软设备码备用验证" />
                                </StackPanel>

                                <Border IsVisible="{Binding IsWaitingMsaVerify}"
                                        Margin="0,4,0,0"
                                        BorderBrush="{DynamicResource ColorBrushGray4}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="10">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontWeight="Bold"
                                                   Text="{Binding MsaWaitHint}" />
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="10">
                                            <ui:MyTextBox Width="180"
                                                          IsReadOnly="True"
                                                          Text="{Binding MsaUserCode}" />
                                            <ui:MyButton MinWidth="120"
                                                         Height="32"
                                                         Command="{Binding ReopenMsaBrowserCommand}"
                                                         Text="打开微软验证页" />
                                            <ui:MyButton MinWidth="90"
                                                         Height="32"
                                                         Command="{Binding CancelMsaVerifyCommand}"
                                                         Text="取消验证" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{DynamicResource ColorBrushGray4}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock FontWeight="SemiBold"
                                           Text="步骤 4 · 邀请码或 AI 评分入服问卷" />
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">
                                    <ui:MyTextBox Grid.Column="0"
                                                  HintText="如果有老玩家邀请码，可在此直接填写"
                                                  IsEnabled="{Binding IsNotBusy}"
                                                  Text="{Binding InviteCodeInput, Mode=TwoWay}" />
                                    <ui:MyButton Grid.Column="1"
                                                 MinWidth="120"
                                                 Height="34"
                                                 Command="{Binding ApplyInviteCodeCommand}"
                                                 IsEnabled="{Binding IsNotBusy}"
                                                 Text="使用邀请码" />
                                </Grid>

                                <TextBlock TextWrapping="Wrap"
                                           Text="{Binding QuestionnaireHintText}" />

                                <StackPanel Orientation="Horizontal"
                                            Spacing="10">
                                    <ui:MyButton MinWidth="130"
                                                 Height="34"
                                                 Command="{Binding LoadQuestionnaireCommand}"
                                                 IsEnabled="{Binding IsNotBusy}"
                                                 Text="加载入服问卷" />
                                    <ui:MyButton MinWidth="160"
                                                 Height="34"
                                                 ColorType="Highlight"
                                                 IsVisible="{Binding HasQuestionnaireQuestions}"
                                                 Command="{Binding SubmitQuestionnaireCommand}"
                                                 IsEnabled="{Binding IsNotBusy}"
                                                 Text="提交问卷并实时评分" />
                                </StackPanel>

                                <ItemsControl IsVisible="{Binding HasQuestionnaireQuestions}"
                                              ItemsSource="{Binding Questions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="dpvm:DreamPortQuestionVm">
                                            <Border Margin="0,6,0,0"
                                                    BorderBrush="{DynamicResource ColorBrushGray4}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="10">
                                                <StackPanel Spacing="6">
                                                    <TextBlock FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding HeaderText}" />
                                                    <TextBlock FontSize="12"
                                                               Text="{Binding ConstraintText}" />
                                                    <ui:MyTextBox IsVisible="{Binding IsTextQuestion}"
                                                                  AcceptsReturn="{Binding Multiline}"
                                                                  TextWrapping="Wrap"
                                                                  HintText="{Binding Placeholder}"
                                                                  Text="{Binding AnswerText, Mode=TwoWay}" />
                                                    <ItemsControl IsVisible="{Binding IsChoiceQuestion}"
                                                                  ItemsSource="{Binding Options}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="dpvm:DreamPortQuestionOptionVm">
                                                                <ui:MyCheckBox Margin="0,4,0,2"
                                                                               Checked="{Binding IsChecked, Mode=TwoWay}"
                                                                               Text="{Binding Text}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl IsVisible="{Binding HasScoreFeedbacks}"
                                              ItemsSource="{Binding ScoreFeedbacks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="dpvm:DreamPortScoreFeedbackVm">
                                            <Border Margin="0,4,0,0"
                                                    BorderBrush="{DynamicResource ColorBrushGray4}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8">
                                                <StackPanel Spacing="2">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="10">
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Text="{Binding HeaderText}" />
                                                        <TextBlock Text="{Binding ScoreText}" />
                                                    </StackPanel>
                                                    <TextBlock FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding ReasonText}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border IsVisible="{Binding HasQuestionnaireSummary}"
                                        BorderBrush="{DynamicResource ColorBrushGray4}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="10">
                                    <TextBlock TextWrapping="Wrap"
                                               Text="{Binding QuestionnaireSummaryText}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ui:MyCard>

            <ui:MyCard Margin="0,0,0,15"
                       CanSwap="True"
                       IsVisible="{Binding IsLoggedIn}"
                       Title="已登录设备管理">
                <StackPanel Margin="25,40,25,20"
                            Spacing="10">
                    <TextBlock TextWrapping="Wrap"
                               Text="{Binding SessionsSummaryText}" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="10">
                        <ui:MyButton MinWidth="120"
                                     Height="34"
                                     Command="{Binding RefreshSessionsCommand}"
                                     IsEnabled="{Binding IsNotBusy}"
                                     Text="刷新设备列表" />
                        <ui:MyButton MinWidth="150"
                                     Height="34"
                                     ColorType="Red"
                                     IsVisible="{Binding CanManageSessions}"
                                     Command="{Binding RevokeOtherSessionsCommand}"
                                     IsEnabled="{Binding IsNotBusy}"
                                     Text="踢掉其它全部设备" />
                    </StackPanel>

                    <ItemsControl IsVisible="{Binding HasSessions}"
                                  ItemsSource="{Binding SessionItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dpvm:DreamPortSessionItemVm">
                                <Border Margin="0,6,0,0"
                                        BorderBrush="{DynamicResource ColorBrushGray4}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="10">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="12">
                                        <StackPanel Grid.Column="0"
                                                    Spacing="4">
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding HeaderText}" />
                                            <TextBlock FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding MetaText}" />
                                        </StackPanel>
                                        <ui:MyButton Grid.Column="1"
                                                     MinWidth="86"
                                                     Height="32"
                                                     ColorType="Red"
                                                     IsVisible="{Binding CanRevoke}"
                                                     Command="{Binding RevokeCommand}"
                                                     Text="踢下线" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:MyCard>
        </StackPanel>
    </ui:MyScrollViewer>
</ui:MyPageRight>
