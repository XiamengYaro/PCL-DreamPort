<ui:MyPageRight xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:PCL"
                xmlns:ui="using:PCL.UI.Controls"
                x:DataType="vm:PageToolsGameLinkViewModel"
                x:CompileBindings="True"
                x:Class="PCL.Views.Pages.Tools.PageToolsGameLink">
    <ui:MyScrollViewer x:Name="PanBack"
                       HorizontalScrollBarVisibility="Disabled"
                       VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25,10">
            <ui:MyHint Margin="0,15,0,0"
                       Theme="Blue"
                       Text="{Binding StatusHint}" />

            <ui:MyCard Margin="0,15"
                       Title="梦港联机（TCP/TLS 中继）">
                <StackPanel Margin="25,40,25,20"
                            Spacing="12">
                    <TextBlock LineHeight="20"
                               TextWrapping="Wrap"
                               Text="{Binding AccountSummary}" />
                    <TextBlock LineHeight="20"
                               TextWrapping="Wrap"
                               Text="{Binding RelaySummary}" />
                    <StackPanel Margin="0,4,0,0"
                                Orientation="Horizontal"
                                Spacing="12">
                        <ui:MyButton MinWidth="130"
                                     Height="35"
                                     ColorType="Highlight"
                                     Command="{Binding RefreshStatusCommand}"
                                     IsEnabled="{Binding IsNotBusy}"
                                     Text="刷新联机状态" />
                        <ui:MyButton x:Name="BtnGoDreamPortAccount"
                                     MinWidth="130"
                                     Height="35"
                                     Text="前往梦港账号" />
                    </StackPanel>
                </StackPanel>
            </ui:MyCard>

            <ui:MyCard Margin="0,0,0,15"
                       Title="联机架构说明">
                <StackPanel Margin="25,40,25,20"
                            Spacing="8">
                    <TextBlock LineHeight="20"
                               TextWrapping="Wrap"
                               Text="本客户端仅保留梦港联机（TCP/TLS 中继），不接入第三方 P2P 组网组件或额外大厅账号体系。" />
                    <TextBlock LineHeight="20"
                               TextWrapping="Wrap"
                               Text="当前 PoC 阶段支持探测站点联机账号状态与 /api/lobby/config 中继节点下发配置；房间创建、房码加入与局域网端口转发将在 Phase 4 完整接入。" />
                </StackPanel>
            </ui:MyCard>
        </StackPanel>
    </ui:MyScrollViewer>
</ui:MyPageRight>
